<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>arc4u.cyphertool</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <!-- The CLI (tool package) version. -->
    <Version>2.0.0</Version>
  </PropertyGroup>

  <!-- Native AOT: 'dotnet publish -r <rid>' produces a trimmed, self-contained native executable. -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <!-- The native executable has no use for the XML doc file; publishing it fails under AOT (it is not copied to the RID output folder). -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!-- Tool packaging (.NET 10+): 'dotnet pack' builds the top-level package that points to one package per
         RID; 'dotnet pack -r <rid>' (on that OS) builds the native AOT package for it. -->
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-arm64;osx-x64</ToolPackageRuntimeIdentifiers>
    <!-- Restore every RID: the top-level 'dotnet pack' also builds the packages for the current OS. -->
    <RuntimeIdentifiers>$(ToolPackageRuntimeIdentifiers)</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <!-- Keep the native debug symbols out of the publish folder, and so out of the tool packages. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arc4u" />
    <PackageReference Include="Arc4u.Results" />
    <PackageReference Include="McMaster.Extensions.CommandLineUtils" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\HelpTexts.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>HelpTexts.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\HelpTexts.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>HelpTexts.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
